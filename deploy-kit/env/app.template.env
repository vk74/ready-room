# Version: 0.27.4
# Purpose: Production deployment configuration template for evi (NON-SECRET values).
# Deployment file: app.template.env
# Logic: User edits this file; install.sh (deploy) uses it to render Quadlet units and proxy config.
#        Values in this file are real defaults (used by merge_env during updates) or empty (set by admin at install).
#
# Changes in v0.27.4:
# - Default APP_INSTALL_REPO is vk74/ready-room.
#
# Changes in v0.27.2:
# - Add APP_INSTALL_REPO for the distribution GitHub repository.
#
# Changes in v0.26.2:
# - Rename EVI_* configuration keys and template placeholders to APP_* (EVI_APP_DB_PASSWORD becomes APP_DB_PASSWORD).
# 
# Changes in v0.25.4:
# - Renamed from evi.template.env to app.template.env (runtime config/app.env).
#
# Changes in v0.23.9:
# - Empty APP_LIMIT_MEM_STATE is auto-filled at deploy/update from host RAM
#   (test/compact/medium/large/xlarge). Host RAM < 2 GiB stops deploy.
#
# Changes in v1.19.0:
# - Added EVI_NETWORK_SUBNET/EVI_NETWORK_GATEWAY (pin the internal bridge CIDR) and
#   EVI_TRUSTED_PROXY_CIDRS (internal proxy CIDR the backend trusts for real client-IP
#   extraction from X-Forwarded-For, used by the per-IP rate limiter).
#
# Changes in v1.18.4:
# - EVI_FE_API_URL: document that production FE must not use VITE_API_URL=/api (paths already include /api).
#
# Changes in v1.18.3:
# - Added EVI_FS_VOLUME_MAX_GB (default 100): SeaweedFS -volume.max capacity ceiling in GB.
#
# Changes in v1.18.2:
# - Added EVI_FS_DATA_PATH for separate FS volume placement.
#   Empty EVI_FS_DATA_PATH falls back to EVI_DATA_PATH.
#
# Changes in v1.18.1:
# - EVI_FS_BUCKET default: fs -> evi-fs (S3 bucket names require length >= 3).
#
# Changes in v1.18.0:
# - Renamed EVI_FS_* to EVI_FS_* (file storage); EVI_LIMIT_CPU_FS/MEM_FS -> EVI_LIMIT_CPU_FS/MEM_FS.
#   Updated comment: "database, file storage" -> "database, file storage".
#
# Changes in v1.17.0:
# - Removed evi- prefix from Podman network name: evi-net -> net (EVI_NETWORK).
#   Removed evi_ prefix from Valkey secret name: evi_valkey_password -> valkey_password (EVI_VALKEY_SECRET_NAME).
#
# Changes in v1.16.0:
# - Removed evi- prefix from registry image names: ghcr.io/vk74/evi-fe -> fe, evi-be -> be, evi-db -> db, evi-worker -> worker.
#   Updated EVI_FS_BUCKET default: evi-fs -> fs.
#   Updated EVI_FS_SECRET_NAME default: evi_fs_credentials -> fs_credentials.
#
# Changes in v1.15.0:
# - Updated comments to reflect short container names (db, be, fe, state, worker, fs, reverse-proxy).
#
# Changes in v1.14.0:
# - Added EVI_DATA_PATH for separate data disk support. Empty default = standard Podman named volumes.
#
# Changes in v1.13.0:
# - Documented Caddy route for object storage as /objects/* (not /assets/* — reserved for SPA bundles from Vite).
#
# Changes in v1.12.0:
# - Removed placeholder values: EVI_DOMAIN and EVI_ACME_EMAIL are now empty (set by admin at install).
#   All remaining values are real defaults suitable for automatic env merge during updates.
#
# Changes in v1.11.0:
# - Added evi-fs (SeaweedFS) block: EVI_FS_IMAGE, EVI_FS_S3_PORT, EVI_FS_BUCKET,
#   EVI_FS_SECRET_NAME, EVI_LIMIT_CPU_FS, EVI_LIMIT_MEM_FS.
#
# Changes in v1.10.1:
# - Cleanup of obsolete change notes.
#
# Changes in v1.10.0:
# - Removed EVI_NODE_ENV (Go backend does not use NODE_ENV)
#
# Changes in v1.9.0:
# - Added EVI_WORKER_IMAGE, EVI_LIMIT_CPU_WORKER, EVI_LIMIT_MEM_WORKER for evi-worker container
#
# Changes in v1.7.0:
# - Added evi-state (Valkey): EVI_STATE_IMAGE, EVI_VALKEY_PORT, EVI_VALKEY_SECRET_NAME, resource limits
#
# Changes in v1.6.0:
# - Added EVI_FIREWALL_ADMIN_ACCESS and EVI_FIREWALL_ADMIN_ALLOWED for UFW rules (cockpit/pgadmin access)
#
# Changes in v1.5.1:
# - EVI_*_IMAGE use ghcr.io/vk74/... (personal GHCR namespace); align with release publish
#
# Changes in v1.5.0:
# - Added EVI_FE_API_URL configuration for frontend API URL (default: /api)
# - This fixes frontend-backend connection in production builds
#
# Changes in v1.4.0:
# - Removed deprecated "internal" TLS mode (only manual and letsencrypt supported)
# - Updated documentation to reflect guided setup workflow
#
# Changes in v1.3.0:
# - Updated internal deployment scenario to use manual mode with generated certificates
# - Added documentation for TLS certificate generation via install.sh
#
# ============================
# Configuration Scenarios
# ============================
#
# Use install.sh -> "guided setup" for interactive configuration, or edit this file directly.
#
# 1. Internal Use (Private IP / Intranet Domain)
#    - APP_DOMAIN=192.168.1.10 or evi.local
#    - APP_TLS_MODE=manual
#    -> Workflow: install.sh will auto-generate self-signed certificates
#    -> Result: HTTPS works. Browser warning (acceptable) or install evi-tls.crt on clients.
#
# 2. Public Domain (Let's Encrypt)
#    - APP_DOMAIN=example.com
#    - APP_TLS_MODE=letsencrypt
#    - APP_ACME_EMAIL=admin@example.com
#    -> Prerequisites: DNS must point to server, ports 80/443 open to internet
#    -> Result: Automatic trusted HTTPS certificate
#
# 3. Custom Certificates (Corporate / Existing)
#    - APP_DOMAIN=my-secure-site.com
#    - APP_TLS_MODE=manual
#    -> Place cert.pem and key.pem in deployment/env/tls/
#    -> Result: Uses your certificates
#
# =========================
# Core
# =========================

# Public domain or IP for accessing the application.
APP_DOMAIN=

# TLS Mode:
# - "letsencrypt": Automatic public certs via Let's Encrypt (for public domains).
#                  Requires ports 80/443 open to internet and valid DNS.
# - "manual":      Use certificates from deployment/env/tls/ (RECOMMENDED for internal/LAN).
#                  Run install.sh -> guided setup to auto-generate self-signed certificates.
APP_TLS_MODE=letsencrypt

# [For 'manual' mode only] Paths to your certificate files.
# You can use absolute paths or paths relative to the deploy directory.
# Example: If files are in the evi/deployment folder, just use the filename.
APP_TLS_CERT_PATH=
APP_TLS_KEY_PATH=

# [For 'letsencrypt' mode only] Contact email for certificate notifications (recommended).
APP_ACME_EMAIL=

# Host ports (Caddy is the only container binding these ports)
# Traffic flow:
# - Port 80: Redirects to HTTPS. Must be open for Let's Encrypt validation.
# - Port 443: Secure application traffic.
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

# Firewall: who may connect to cockpit (and pgadmin). Set via install.sh guided setup Step 2.
# Values: localhost | allowed_ips | allowed_cidr | any | skip
APP_FIREWALL_ADMIN_ACCESS=localhost
# For allowed_ips: comma-separated IPs (e.g. 192.168.1.10,192.168.1.11). For allowed_cidr: one CIDR (e.g. 192.168.1.0/24).
# APP_FIREWALL_ADMIN_ALLOWED=

# =========================
# Images (registry references)
# =========================

# Distribution GitHub repository (owner/repo for install, updates, and release checks)
APP_INSTALL_REPO=vk74/ready-room

# Reverse proxy (Caddy)
APP_PROXY_IMAGE=docker.io/caddy:2.8-alpine

# Application images (GHCR; namespace evi-app or your username for personal registry)
APP_FE_IMAGE=ghcr.io/vk74/fe:0.27.4-beta
APP_BE_IMAGE=ghcr.io/vk74/be:0.27.4-beta
APP_DB_IMAGE=ghcr.io/vk74/db:0.27.4-beta
APP_STATE_IMAGE=docker.io/valkey/valkey:8-alpine
APP_WORKER_IMAGE=ghcr.io/vk74/worker:0.27.4-beta
APP_FS_IMAGE=docker.io/chrislusf/seaweedfs:4.17

# =========================
# Networking (internal)
# =========================

# Podman network name for internal communication (bridge) between containers
APP_NETWORK=net

# Pinned subnet/gateway for the internal bridge network. Kept deterministic so the
# backend can trust exactly this CIDR when reading the real client IP behind Caddy.
APP_NETWORK_SUBNET=10.89.0.0/24
APP_NETWORK_GATEWAY=10.89.0.1

# CIDR ranges the backend treats as evi's OWN reverse-proxy hops when parsing
# X-Forwarded-For to derive the real client IP for rate limiting. This is evi's
# INTERNAL container network only (NOT any external/LAN network); everything else,
# including private LAN clients, is treated as an untrusted client IP. Comma-separated.
# Add extra CIDRs only for additional trusted proxies you control (e.g. an external LB).
APP_TRUSTED_PROXY_CIDRS=10.89.0.0/24

# Backend internal port (not published on host; Caddy proxies to it)
APP_BE_PORT=7070

# Frontend internal port (nginx in fe image)
APP_FE_PORT=80

# Database internal port
APP_DB_PORT=5432

# Valkey (state) internal port (no host port published)
APP_VALKEY_PORT=6379
APP_VALKEY_SECRET_NAME=valkey_password

# File storage (SeaweedFS S3) internal port (no host port published; Caddy routes /objects/* to S3 gateway)
APP_FS_S3_PORT=8333
APP_FS_BUCKET=evi-fs
APP_FS_SECRET_NAME=fs_credentials

# =========================
# Backend configuration
# =========================

# CORS allowed origins (comma-separated). Must include https://<domain>.
# Defaults to your APP_DOMAIN using variable expansion.
APP_CORS_ORIGINS=https://${APP_DOMAIN}

# =========================
# Frontend configuration
# =========================

# Frontend API URL (VITE_API_URL at FE image build time). Leave empty for production:
# axios paths already start with /api/; setting /api here causes /api/api/... 404 via Caddy.
# Dev builds use http://localhost:7070 (see front/Containerfile / vite dev server).
APP_FE_API_URL=

# =========================
# Database configuration (non-secret)
# =========================

APP_POSTGRES_DB=maindb
APP_POSTGRES_USER=app_service

# Demo data seeding (true/false)
APP_SEED_DEMO_DATA=false

# =========================
# Resource limits (optional)
# =========================

# Examples: "0.5", "1", "2"
APP_LIMIT_CPU_PROXY=
APP_LIMIT_CPU_FE=
APP_LIMIT_CPU_BE=
APP_LIMIT_CPU_DB=
APP_LIMIT_CPU_STATE=
APP_LIMIT_CPU_WORKER=
APP_LIMIT_CPU_FS=

# Examples: "512m", "1g", "2g"
APP_LIMIT_MEM_PROXY=
APP_LIMIT_MEM_FE=
APP_LIMIT_MEM_BE=
APP_LIMIT_MEM_DB=
# Empty: auto-fill test/compact/medium/large/xlarge from host RAM. Host RAM < 2 GiB stops deploy.
APP_LIMIT_MEM_STATE=
APP_LIMIT_MEM_WORKER=
APP_LIMIT_MEM_FS=

# =========================
# Data storage (optional separate disk)
# =========================

# Base path to external data directory for DB volume bind-mount.
# Empty = use standard Podman named DB volume on the system disk.
# Example: /mnt/data-disk/data — DB volume binds from /mnt/data-disk/data/db.
APP_DATA_PATH=

# Optional separate base path for FS volume bind-mount.
# Empty = fallback to APP_DATA_PATH.
# Example: /mnt/fs-disk/data — FS volume binds from /mnt/fs-disk/data/fs.
APP_FS_DATA_PATH=

# Maximum file storage capacity (GB). Maps to SeaweedFS -volume.max (each internal volume file is up to 1 GB).
# Does NOT pre-allocate disk space — files grow as users upload.
APP_FS_VOLUME_MAX_GB=100

# =========================
# Optional pgAdmin (disabled by default)
# =========================

APP_PGADMIN_ENABLED=false
APP_PGADMIN_IMAGE=docker.io/dpage/pgadmin4:9.15
# Bind pgAdmin: 0.0.0.0 = all interfaces (browser from any computer). Use firewall to restrict.
APP_PGADMIN_HOST=0.0.0.0
APP_PGADMIN_PORT=5445
APP_PGADMIN_EMAIL=evidba@pgadmin.app
