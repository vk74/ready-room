# Version: 0.26.2
# Purpose: Podman Quadlet volume for PostgreSQL data persistence.
# Deployment file: db.volume
# Logic: Creates a named volume used by the db container.
#        When APP_DATA_PATH is set, bind-mounts from the external data directory
#        via {{APP_DATA_VOLUME_OPTIONS_DB}} (Driver=local, Options=type=none,...).
#
# Changes in v0.26.2:
# - Rename EVI_* configuration keys and template placeholders to APP_* (EVI_APP_DB_PASSWORD becomes APP_DB_PASSWORD).
# 
# Changes in v0.25.4:
# - Removed product name prefix from [Unit] Description.
#
# Changes in v1.3.0:
# - Renamed volume name from evi_db_data to db_data.
#
# Changes in v1.2.0:
# - Renamed from evi-db.volume to db.volume.
#
# Changes in v1.1.0:
# - Added {{EVI_DATA_VOLUME_OPTIONS_DB}} placeholder for optional bind-mount to separate data disk.
#
# Changes in v1.0.0:
# - Initial DB volume definition
#

[Unit]
Description=database volume (Podman)

[Volume]
VolumeName=db_data
{{APP_DATA_VOLUME_OPTIONS_DB}}
