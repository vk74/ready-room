# Version: 0.26.2
# Purpose: Podman Quadlet volume for fs store (SeaweedFS) persistent data storage.
# Deployment file: fs.volume
# Logic: Creates a named volume used by the fs container for SeaweedFS volume files and indexes.
#        When APP_DATA_PATH is set, bind-mounts from the external data directory
#        via {{APP_DATA_VOLUME_OPTIONS_FS}} (Driver=local, Options=type=none,...).
#
# Changes in v0.26.2:
# - Rename EVI_* configuration keys and template placeholders to APP_* (EVI_APP_DB_PASSWORD becomes APP_DB_PASSWORD).
# 
# Changes in v0.25.4:
# - Removed product name prefix from [Unit] Description.
#
# Changes in v1.4.0:
# - Renamed from assets.volume to fs.volume; volume name changed from assets_data to fs_data;
#   #
# Changes in v1.3.0:
# - Renamed volume name from evi_fs_data to fs_data.
#
# Changes in v1.2.0:
# - Renamed from evi-fs.volume to fs.volume.
#
# Changes in v1.1.0:
# - Added {{EVI_DATA_VOLUME_OPTIONS_FS}} placeholder for optional bind-mount to separate data disk.
#
# Changes in v1.0.0:
# - Initial fs volume definition
#

[Unit]
Description=fs volume (Podman)

[Volume]
VolumeName=fs_data
{{APP_DATA_VOLUME_OPTIONS_FS}}
