INDEX	activity_acceptances.idx_activity_acceptances_group_open	CREATE INDEX idx_activity_acceptances_group_open ON app.activity_acceptances USING btree (assigned_group_id, created_at DESC) WHERE (status = ANY (ARRAY['new'::app.activity_acceptance_status, 'in_progress'::app.activity_acceptance_status]))
