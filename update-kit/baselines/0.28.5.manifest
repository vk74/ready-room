INDEX	activity_approvals.idx_activity_approvals_group_open	CREATE INDEX idx_activity_approvals_group_open ON app.activity_approvals USING btree (assigned_group_id, created_at DESC) WHERE (status = ANY (ARRAY['new'::app.activity_approval_status, 'in_progress'::app.activity_approval_status, 'paused'::app.activity_approval_status]))
INDEX	activity_approvals.idx_activity_approvals_parent	CREATE INDEX idx_activity_approvals_parent ON app.activity_approvals USING btree (parent_kind, parent_id)
INDEX	activity_approvals.idx_activity_approvals_status	CREATE INDEX idx_activity_approvals_status ON app.activity_approvals USING btree (status)
INDEX	activity_approvals.idx_activity_approvals_title_trgm	CREATE INDEX idx_activity_approvals_title_trgm ON app.activity_approvals USING gin (lower((title)::text) gin_trgm_ops)
